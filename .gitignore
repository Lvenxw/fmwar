# ===========================================================================
# DSH / agent harness artifacts
# ===========================================================================

# DSH tooling state (sandbox diagnostics, session scratch data)
.dsh/
.scratch/

# Sandbox file-permission diagnostic output, written inside or beside the repo
.acl-recovery/
*-acl-recovery/

# ===========================================================================
# Build output and caches
# ===========================================================================

# Gradle
.gradle/
build/

# Kotlin compiler and language caches
.kotlin/

# Byte-compiled output from IDEs and other build tools
out/
bin/
classes/

# ===========================================================================
# IDE and editor state
# ===========================================================================

# IntelliJ IDEA
.idea/
*.iml
.idea_modules/

# Eclipse
.settings/
.classpath
.project
.factorypath
.externalToolBuilders/
.metadata/

# VS Code
.vscode/

# NetBeans
nbproject/private/
.nb-gradle/

# ===========================================================================
# OS and runtime junk
# ===========================================================================

# MacOS DS_Store files
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# Virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Editor backups and logs
*.log
*.bak
*.orig
*.rej
*~

# Common working directory for local server runs
run/
